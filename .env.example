# =============================================================================
# Nanobot Environment Variables — Copy to .env and fill in your values
# =============================================================================
# NEVER commit your real .env file. It is excluded via .gitignore.

# --------------- LLM Provider API Keys ---------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --------------- Optional LLM Providers ---------------
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=
OLLAMA_API_KEY=

# --------------- Web Search & Tools ---------------
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=

# --------------- WhatsApp Bridge ---------------
BRIDGE_TOKEN=
BRIDGE_PORT=3001

# --------------- Streamlit UI ---------------
NANOBOT_UI_PASSWORD=

# --------------- User Auth (multi-user mode) ---------------
NANOBOT_AUTH_DB=
NANOBOT_BASE_URL=http://localhost:8501

# --------------- SMTP (for email verification & password reset) ---------------
NANOBOT_SMTP_HOST=
NANOBOT_SMTP_PORT=587
NANOBOT_SMTP_USER=
NANOBOT_SMTP_PASS=
NANOBOT_SMTP_FROM=

# --------------- Binance.US Trading ---------------
BINANCE_US_API_KEY=
BINANCE_US_API_SECRET=
BINANCE_US_BASE_URL=https://api.binance.us
BINANCE_US_SANDBOX=false

# --------------- Trading Preferences ---------------
TRADING_PRIMARY_PAIR=BTC/USDT
TRADING_PAIRS=BTC/USDT,ETH/USDT
TRADING_RISK_TOLERANCE=medium
TRADING_STRATEGY=dca
TRADING_DAILY_LIMIT=1000
TRADING_STOP_LOSS_PCT=0.05
TRADING_TAKE_PROFIT_PCT=0.10
